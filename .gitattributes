# 저장소는 LF로 저장하고, 작업 트리에도 LF로 체크아웃한다.
# (core.autocrlf=true인 Windows 환경에서 prettier endOfLine:"lf" 검사가 깨지는 것을 막는다)
* text=auto eol=lf

# 바이너리 애셋은 변환 대상에서 제외
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.keystore binary
*.jks    binary
